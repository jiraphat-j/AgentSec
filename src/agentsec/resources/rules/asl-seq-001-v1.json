{
  "schema_version": "1.0",
  "rule_id": "ASL-SEQ-001",
  "rule_version": 1,
  "description": "Untrusted document context preceded a fake-secret read request",
  "severity": "high",
  "supported_event_versions": ["0.1", "0.2"],
  "kind": "sequence",
  "steps": [
    {
      "name": "document",
      "predicates": [
        {"field": "event_type", "operator": "equals", "value": "agent.context.document_added"},
        {"field": "payload.trust", "operator": "equals", "value": "untrusted"}
      ]
    },
    {
      "name": "request",
      "predicates": [
        {"field": "event_type", "operator": "equals", "value": "tool.requested"},
        {"field": "payload.tool", "operator": "equals", "value": "read_file"}
      ]
    }
  ]
}
